{
  "name": "crownhold",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open /game.html",
    "build": "vite build && node scripts/release.js",
    "sim": "node sim/sim.js",
    "verify": "node sim/verify-skills.mjs",
    "check": "npm run build && npm run verify && npm run verify:ui && npm run sim",
    "server": "node server/server.js",
    "deploy": "sh scripts/deploy.sh",
    "verify:ui": "node sim/verify-ui.mjs"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
