{
  "name": "crownhold",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open /game.html",
    "build": "vite build && node scripts/release.js",
    "sim": "node sim/sim.js",
    "verify": "node sim/verify-skills.mjs",
    "check": "npm run build && npm run verify && npm run verify:ui && npm run verify:server && npm run verify:audio && npm run sim && npm run scroll && echo '== check complete: build + verify + verify:ui + verify:server + verify:audio + sim + scroll =='",
    "server": "node server/server.js",
    "deploy": "sh scripts/deploy.sh",
    "verify:ui": "node sim/verify-ui.mjs",
    "shoot": "sh scripts/shoot.sh",
    "sprites": "node scripts/emit-sprites.js",
    "verify:server": "node sim/verify-server.mjs",
    "verify:audio": "node scripts/audio-probe.js",
    "phone": "node scripts/phone.js",
    "screens": "node scripts/screens.js",
    "sounds": "node scripts/emit-sounds.js",
    "scroll": "node scripts/scroll.js",
    "ally": "node scripts/ally-lab.js"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
